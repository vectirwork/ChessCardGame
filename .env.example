# ─── Obligatoire ───────────────────────────────────────────────────────────
# Votre nom de domaine (sans https://), déjà pointé vers l'IP du serveur
DOMAIN=spellmate.fr
# Mot de passe de la base de données (long et aléatoire)
POSTGRES_PASSWORD=changez-moi-avec-un-long-mot-de-passe
# Clé secrète (au moins 32 caractères) : générez-la avec  openssl rand -hex 32
SECRET_KEY=
# E-mails des administrateurs (accès à /admin), séparés par des virgules
ADMIN_EMAILS=vous@exemple.fr

# ─── Paiements Stripe ──────────────────────────────────────────────────────
# stripe = vrais paiements, demo = paiements simulés (tests), off = boutique fermée
PAYMENTS_MODE=stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# TVA calculée automatiquement par Stripe Tax (à activer aussi dans Stripe)
STRIPE_AUTOMATIC_TAX=false
# Factures Stripe après paiement (option payante chez Stripe)
STRIPE_INVOICES=false

# ─── E-mails (vérification, mot de passe oublié, confirmations d'achat) ────
# Exemples : Brevo (smtp-relay.brevo.com:587), Mailjet, OVH, Scaleway TEM…
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Spellmate <no-reply@spellmate.fr>

# ─── Mentions légales (affichées sur le site) ──────────────────────────────
APP_NAME=Spellmate
LEGAL_COMPANY=Votre société SAS
LEGAL_ADDRESS=1 rue de l'Exemple, 75000 Paris
LEGAL_SIREN=000 000 000
LEGAL_VAT=FR00000000000
LEGAL_DIRECTOR=Prénom Nom
LEGAL_CONTACT=contact@spellmate.fr
LEGAL_HOST=Hetzner Online GmbH, Industriestr. 25, 91710 Gunzenhausen, Allemagne

# ─── Fonctions du site (interrupteurs, facultatif) ─────────────────────────
# Tout est ouvert par défaut. 0 coupe une fonction sans reconstruire le site, 1 la rouvre : le serveur refuse ce qui
# est coupé et le site le masque. Une valeur ou un nom inconnus sont signalés au démarrage (le défaut est gardé).
# Liste : src/shared/config/features.ts (homeDuel → FEATURE_HOME_DUEL, friendlyQueue → FEATURE_FRIENDLY_QUEUE…).
# FEATURE_NEW_GAMES=0   maintenance : plus de nouvelle partie, celles en cours continuent
# FEATURE_RANKED=0      parties classées
# FEATURE_GUEST_PLAY=0  jeu sans compte
# FEATURE_LIVE=0        parties en direct et spectateurs
# FEATURE_SHOP=0        boutique

# ─── Avancé (facultatif) ───────────────────────────────────────────────────
# Mandataires de confiance devant le serveur : un nombre (1 derrière Caddy, défaut en production), true ou false.
# Sous docker compose, docker-compose.yml le transmet au serveur, et vaut true (1 mandataire) s'il est absent ici.
# TRUST_PROXY=1
# Connexions PostgreSQL ouvertes au plus
# DATABASE_POOL_MAX=10
