# Configuration de production de chess-powers.com. Rien de secret ici : le mot de passe de la base et la clé secrète
# sont générés sur le serveur (/opt/spellmate/secrets.env) ; les clés Stripe et SMTP iront dans
# /opt/spellmate/local.env, jamais dans ce dépôt public.
DOMAIN=chess-powers.com
APP_NAME=Spellmate
# Boutique fermée tant que Stripe n'est pas configuré (demo offrirait les objets gratuitement).
PAYMENTS_MODE=off
MAIL_FROM=Spellmate <no-reply@chess-powers.com>
LEGAL_HOST=Hetzner Online GmbH, Industriestr. 25, 91710 Gunzenhausen, Allemagne
