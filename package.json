{
  "name": "spellmate",
  "version": "1.0.0",
  "private": true,
  "description": "Spellmate : les échecs avec des cartes de pouvoir. Site complet (comptes, parties en ligne, invitations, boutique de skins).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false --ignore 'src/client/**' src/server/index.ts",
    "build": "vite build && node scripts/build-server.mjs",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "migrate": "node dist/server/index.js --migrate-only",
    "test:integration": "node test/integration.mjs"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.16.0",
    "socket.io": "^4.8.1",
    "stripe": "^23.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.0",
    "@fontsource/cinzel": "^5.2.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.0",
    "socket.io-client": "^4.8.1",
    "three": "^0.186.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
